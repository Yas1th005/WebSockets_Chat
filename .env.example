# Supabase (full backend storage)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional fallback if you do not use service role key
# SUPABASE_ANON_KEY=your-anon-key

# Optional: override table names (defaults shown)
SUPABASE_USERS_TABLE=users
SUPABASE_CONVERSATIONS_TABLE=conversations
SUPABASE_MESSAGES_TABLE=messages

# Backend port
PORT=5000

# Frontend socket target (for local development)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
